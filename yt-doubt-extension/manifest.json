{
  "manifest_version": 3,
  "name": "YT Doubt Solver",
  "version": "1.0",
  "description": "Ask questions about the YouTube video you're watching, grounded in its transcript.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}