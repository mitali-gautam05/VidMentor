GROQ_API_KEY=your_groq_api_key_here
GROQ_TIMEOUT_SEC=30.0

# Optional: opt-in to multilingual embeddings for Hindi transcripts (requires ~445MB RAM)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# Chat memory limits (optional; MAX_HISTORY_MESSAGES is rounded down to the nearest even number)
# MAX_HISTORY_MESSAGES=20   # max messages kept per video session
# MAX_CHAT_SESSIONS=100    # max concurrent video sessions in memory (LRU-evicted)

# Follow-up question rewriting (optional)
# REWRITE_ENABLED=1        # set to 0 to turn the rewrite off (each rewritten follow-up is one extra Groq call)
# REWRITE_TIMEOUT_SEC=8.0  # timeout in seconds for the rewrite call; on a timeout or error the raw question is used

# Cache (optional; default is the local disk folder rag_cache)
# CACHE_DIR=/data/cache         # disk backend: point at a persistent volume to keep indexes across restarts
# CACHE_BACKEND=redis           # "disk" (default) or "redis"; redis needs: pip install -r requirements-redis.txt
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SEC=0               # seconds before a Redis entry expires; 0 or unset = never
